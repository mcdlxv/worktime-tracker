# Leave empty to use the local SQLite file ./data/worktime.db.
# For a Turso database: DATABASE_URL=libsql://<database>.turso.io and DATABASE_AUTH_TOKEN=<token>.
# On Vercel, the Turso Cloud integration sets TURSO_DATABASE_URL and TURSO_AUTH_TOKEN instead;
# the app uses them when DATABASE_URL is empty.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
